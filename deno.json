{
  "license": "MPL-2.0",
  "links": [
    "libs/@types/gecko"
  ],
  "workspace": [
    "./libs/*",
    "./browser-features/*",
    "./bridge/*"
  ],
  "imports": {
    "@std/cli": "jsr:@std/cli@^1.0.25",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/fs": "jsr:@std/fs@^1.0.20",
    "@std/path": "jsr:@std/path@^1.1.4",
    "#libs/": "./libs/",
    "#features-chrome/": "./browser-features/chrome/",
    "@neoworks/harness/client": "./libs/switchboard/src/client/index.ts",
    "#modules/": "./browser-features/modules/",
    "#features-modules/": "./browser-features/modules/",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/streams": "jsr:@std/streams@^1.0.14",
    "@std/toml": "npm:@jsr/std__toml@^1.0.11",
    "fflate": "npm:fflate@^0.8.3",
    "vite": "npm:vite@^7.3.0"
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "deno.window",
      "ESNext"
    ],
    "checkJs": true,
    "skipLibCheck": true
  },
  "exclude": [
    "tools/build/tasks/inject/wasm/nora-inject.js",
    "**/_dist/**/*",
    "**/*.timestamp-*.mjs",
    "libs/@types/gecko/**/*",
    "libs/vite-plugin-gen-jarmn/**/*",
    "libs/vite-plugin-disable-csp/**/*",
    "tools/build/tasks/inject/mixins/**/*",
    "bridge/loader-features/vite.config.ts",
    "bridge/loader-modules/tsdown.config.ts",
    "bridge/startup/tsdown.config.ts",
    "logs/**/*",
    "node_modules/**/*"
  ],
  "tasks": {
    "feles-build": "deno run -A tools/feles-build.ts",
    "dev-tool": "deno run -A tools/dev-tool.ts",
    "firefox-tests:collect": "deno run --allow-read=floorp-runtime.lock.json --allow-write=_dist --allow-run=git tools/firefox-tests/collect_firefox_tests.ts",
    "firefox-tests:triage-browser": "deno run --allow-read --allow-write=_dist tools/firefox-tests/triage_firefox_browser_tests.ts",
    "firefox-tests:prepare-browser": "deno run --allow-read --allow-write=browser-features/chrome/test/firefox-downloaded/generated tools/firefox-tests/prepare_firefox_browser_tests.ts",
    "test": "deno run -A tools/src/colocated_test_runner.ts",
    "test:firefox-tests": "deno test --allow-read --allow-write --allow-run=git tools/firefox-tests/",
    "test:host": "deno test --allow-read --allow-write tools/src/",
    "test:smoke": "deno run -A tools/src/smoke_runner.ts"
  },
  "nodeModulesDir": "manual"
}
